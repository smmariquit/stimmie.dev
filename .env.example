# Opportunity cover images (`npm run opportunities:images`)
# ScreenshotOne: https://screenshotone.com (recommended for production)
SCREENSHOTONE_ACCESS_KEY=

# ScreenshotOne uses: jpg, block_ads/cookie_banners/trackers, delay=0, timeout=60, quality=80
# Viewport: 1200×630 (OG card ratio). Override provider with OPPORTUNITY_SCREENSHOT_PROVIDER.

# Optional: Microlink Pro key (free tier works without this)
# MICROLINK_API_KEY=

# Force provider: screenshotone | microlink
# OPPORTUNITY_SCREENSHOT_PROVIDER=microlink

# Opportunities stale nag (`npm run opportunities:stale-nag`)
# Resend: https://resend.com — free tier is enough for daily nags
RESEND_API_KEY=
OPPORTUNITIES_NAG_TO=
# Verified sender in Resend, e.g. opportunities@stimmie.dev
# Until verified, Resend sandbox only delivers to your account email:
# OPPORTUNITIES_NAG_FROM=stimmie.dev <onboarding@resend.dev>
OPPORTUNITIES_NAG_FROM=
# Days without bumping opportunitiesBoard.lastUpdated before emails start (default 14)
OPPORTUNITIES_STALE_DAYS=14

# --- Datadog (us5.datadoghq.com) — optional; no-ops when unset ---
# RUM: UX Monitoring → browser app → Application ID + Client Token
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DD_ENV=production
NEXT_PUBLIC_DD_VERSION=
# APM traces via @vercel/otel → set on Vercel (server only):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.us5.datadoghq.com
# OTEL_EXPORTER_OTLP_HEADERS=dd-api-key=<DD_API_KEY>
# DD_API_KEY=  (also used by CI Visibility in GitHub Actions)
