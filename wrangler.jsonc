{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stimmie-dev",
  "account_id": "847a37119fd03f8765b62a6775a6c204",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // `next build` writes the static export to out/. Assets are matched first;
  // the Worker only runs on a miss (API, short links, 404).
  "assets": { "directory": "./out", "binding": "ASSETS" }
}
